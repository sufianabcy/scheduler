{
  "name": "planner-server",
  "version": "0.1.0",
  "private": true,
  "description": "API server for Planner",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.js'",
    "user": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/cli/users.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "web-push": "3.6.7"
  }
}
