# Copy to .env and adjust. All values are optional; these are the defaults.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/planner.db
# Folder with the built web app (cd web && npm run build). Defaults to ../web/dist.
# WEB_DIR=../web/dist
# Set to true behind HTTPS (production) so the login cookie is only sent over HTTPS.
COOKIE_SECURE=false
# Set to true when running behind Caddy, so the real client IP is used for login rate limiting.
TRUST_PROXY=false
# Push notifications. Keys are created on first start and saved in the database; set these only to reuse
# keys from elsewhere. VAPID_SUBJECT is a contact the push services can use: mailto: or https: URL.
VAPID_SUBJECT=mailto:planner@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Mail (Gmail and Outlook). Mail stays switched off until MAIL_TOKEN_KEY is set.
# The address you open the app at. Google and Microsoft send the browser back to <PUBLIC_URL>/api/mail/callback/...
# On your Mac use http://localhost:3000 (not 127.0.0.1) and open the app at that exact address.
# PUBLIC_URL=http://localhost:3000
# 32 random bytes, base64: openssl rand -base64 32. Keep a copy in your password manager.
# MAIL_TOKEN_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
