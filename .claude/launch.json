{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app (built)",
      "runtimeExecutable": "env",
      "runtimeArgs": ["DB_PATH=server/data/preview.db", "PORT=3100", "node", "--disable-warning=ExperimentalWarning", "server/src/index.js"],
      "port": 3100
    },
    {
      "name": "api (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "server", "run", "dev"],
      "port": 3000
    },
    {
      "name": "web (dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
